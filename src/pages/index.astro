---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { profile } from '../data/profile';
import { publishedPosts, publishedProjects, projectUrl } from '../lib/content';
const posts = await publishedPosts();
const projects = await publishedProjects();
const primary = projects[0];
const articles = posts.filter(p => p.data.kind === 'article');
const selected = articles.filter(p => p.data.featured);
const notes = posts.filter(p => p.data.kind === 'note');
---
<Base>
  <div class="home-kicker"><span class="eyebrow">代码 / 实践 / 生长</span><span>{profile.city} · 后端工程与 AI 应用</span></div>
  <div class="grid">
    <section class="card hero hero-identity">
      <div class="identity-top"><span class="identity-label">个人简介</span><span class="identity-location">{profile.city} <span aria-hidden="true">↗</span></span></div>
      <h1>{profile.name}<span class="name-period" aria-hidden="true">.</span></h1>
      <h2>让复杂止于代码，<br /><span>让简单抵达世界。</span></h2>
      <p>{profile.intro}</p>
      <div class="hero-meta"><a class="button" href="/resume/">查看我的简历 <span aria-hidden="true">↗</span></a><a class="text-link" href="/projects/">探索项目 <span aria-hidden="true">→</span></a></div>
    </section>
    <section class="card focus-card">
      <div class="focus-heading"><span class="eyebrow">实践 / 记录</span><span class="focus-mark" aria-hidden="true">↗</span></div>
      <h2>我在做什么<span>，</span><br />又在思考什么<span>。</span></h2>
      <nav class="focus-list" aria-label="了解我的实践">
        <a href="/projects/cloud-gaming/"><span class="focus-index">01</span><span><strong>后端系统</strong><small>Go · 实例管理 · 内容分发</small></span><span aria-hidden="true">↗</span></a>
        <a href="/projects/ask-venture/"><span class="focus-index">02</span><span><strong>AI 工具</strong><small>MCP · Skills · 排障实践</small></span><span aria-hidden="true">↗</span></a>
        <a href="/notes/"><span class="focus-index">03</span><span><strong>持续学习</strong><small>技术文章 · 札记 · 阶段思考</small></span><span aria-hidden="true">↗</span></a>
      </nav>
    </section>
    {primary && <a class="card project link" href={projectUrl(primary)}><div class="section-label"><span>01 / 代表项目</span><span class="arrow" aria-hidden="true">↗</span></div><h2>让排障，<br />从线索走向证据。</h2><p>{primary.data.title}</p><p>{primary.data.description}</p><div class="project-art" aria-label="工作流程：澄清目标、证据取证、研发交接"><span class="node">澄清目标</span><span class="connector"></span><span class="node primary">证据取证</span><span class="connector"></span><span class="node">研发交接</span></div><div class="project-foot"><div class="tags">{primary.data.tags.slice(0,3).map(tag => <span class="tag">{tag}</span>)}</div><span>查看项目故事 →</span></div></a>}
    <section class="card work"><div class="section-label"><span>02 / 工作经历</span><a href="/resume/">完整简历 ↗</a></div><div class="timeline">{profile.experience.slice(0,2).map(job => <div class="job"><small>{job.date}</small><h3>{job.role}</h3><p>{job.company}</p><p class="job-description">{job.description}</p></div>)}</div></section>
    <section class="card skills"><div class="section-label"><span>03 / 技术与实践</span><span aria-hidden="true">↗</span></div><h2>工具服务于问题，<br />实践形成理解。</h2><div class="tags">{profile.skills.map(skill => <span class="tag">{skill}</span>)}</div></section>
    <section class="card writing"><div class="section-label"><span>04 / 精选文章</span><a href="/blog/">全部文章 ↗</a></div><PostList posts={(selected.length ? selected : articles).slice(0,3)} /></section>
    <a class="card now link" href="/notes/"><div class="section-label"><span>05 / 正在生长</span><span class="arrow" aria-hidden="true">↗</span></div><h2>留下一点，思考的痕迹。</h2><p>{notes[0]?.data.title ?? '学习札记与阶段复盘，正在整理。'}</p><p class="now-link">{notes[0]?.data.example ? '当前为标注的示例札记' : '查看学习札记'} →</p></a>
    <section class="card contact"><div class="section-label"><span>06 / 联系我</span><span aria-hidden="true">↗</span></div><h2>好的合作，从一次交流开始。</h2><ContactLinks /></section>
  </div>
</Base>
