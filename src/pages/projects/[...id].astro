---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectStoryDetail from '../../components/ProjectStoryDetail.astro';
import ProjectStoriesIndex from '../../components/ProjectStoriesIndex.astro';
import { projectStories, type ProjectStory } from '../../data/project-stories';
import { publishedProjects } from '../../lib/content';
export async function getStaticPaths() {
  const storyIds = new Set(projectStories.map(project => project.id));
  const legacyProjects = (await publishedProjects()).filter(project => !storyIds.has(project.id));
  return [
    ...projectStories.map((project, index) => ({ params: { id: project.id }, props: { story: project, next: projectStories[(index + 1) % projectStories.length] } })),
    ...legacyProjects.map(project => ({ params: { id: project.id }, props: { legacy: project } })),
  ];
}
interface Props { story?: ProjectStory; next?: ProjectStory; legacy?: CollectionEntry<'projects'>; }
const { story, next, legacy } = Astro.props;
const renderedLegacy = legacy ? await render(legacy) : undefined;
const Content = renderedLegacy?.Content;
const title = story?.title ?? legacy?.data.title ?? '项目';
const description = story?.intro ?? legacy?.data.description;
---
<Base title={`${title} · 段锦涛`} description={description}>
  {story && next ? <ProjectStoryDetail project={story} next={next} /> : <>
    {legacy?.id === 'cloud-gaming' && <ProjectStoriesIndex projects={projectStories.slice(2)} title="云游戏系统工程" intro="从中心到实例，将内容交付、任务编排和实例侧 Agent 管理拆成三个案例，分别讲清职责、机制与工程取舍。" />}
    {legacy && Content && <article class="article"><a class="back" href="/projects/">← 返回项目</a><div class="eyebrow">项目实践 / {legacy.data.role}</div><h1>{legacy.data.title}</h1><p class="lead">{legacy.data.description}</p><div class="tags">{legacy.data.tags.map(tag => <span class="tag">{tag}</span>)}</div><div class="prose"><Content /></div><div class="project-links">{legacy.data.source && <a class="button" href={legacy.data.source} target="_blank" rel="noopener noreferrer">查看源码 ↗</a>}{legacy.data.demo && <a class="button" href={legacy.data.demo} target="_blank" rel="noopener noreferrer">查看演示 ↗</a>}</div></article>}
  </>}
</Base>
